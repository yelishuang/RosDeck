@@ -0,0 +15 @@
+# Normalize line endings; keep binaries untouched
+* text=auto
+
+# Treat assets and fonts as binary
+*.png binary
+*.jpg binary
+*.jpeg binary
+*.gif binary
+*.webp binary
+*.svg text eol=lf
+*.woff binary
+*.woff2 binary
+*.ttf binary
+*.pdf binary
+*.zip binary
